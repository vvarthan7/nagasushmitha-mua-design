{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Deployment config for Cloudflare Workers. Its presence is what stops
  // `wrangler deploy` from running framework auto-detection — that path tries
  // to wire in @cloudflare/vite-plugin, which needs Vite 6+, and fails the
  // build on Vite 5 before anything is compiled.
  //
  // `name` is the Worker script this deploys to. Changing it does not rename
  // anything: it publishes to a *different* Worker and leaves the old one
  // running, still holding whatever custom domain was attached to it. That is
  // why a rename has to be followed by re-pointing the domain by hand, and why
  // this line should not be edited casually.
  "name": "nsmakeupartistry",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",

  // Everything `vite build` emits, served straight from Cloudflare's edge.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",

    // ── Pre-launch only ──────────────────────────────────────────────────
    // Normally Cloudflare answers asset requests at the edge and never invokes
    // the Worker, so the three pages cost no invocations. That is the right
    // arrangement — but it also means worker/index.ts cannot see those
    // requests, and the launch gate inside it would never run. The site would
    // be readable at nsmakeupartistry.com the moment the domain is attached.
    //
    // So until launch, every request goes through the Worker. Pre-launch
    // traffic is a handful of visits, so the invocations are free in practice.
    //
    // AT LAUNCH: delete this line in the same commit that sets LAUNCHED to
    // true. Leaving it behind is not a bug, but it bills an invocation for
    // every image on every page load, forever.
    "run_worker_first": true
  },

  // Non-secret configuration lives here rather than in the dashboard, and the
  // distinction is load-bearing. `wrangler deploy` replaces the Worker's
  // bindings with exactly what this file declares, so a *plain-text* variable
  // typed into the dashboard is deleted by the next deploy — silently, and the
  // enquiry endpoint starts answering 500 with nothing in the logs to say a
  // variable went missing. Encrypted secrets are the exception: they survive
  // deploys and must never appear here, because this file is public.
  //
  // So: addresses here, RESEND_API_KEY as a dashboard secret. See README.
  "vars": {
    "ENVIRONMENT": "production",

    // ── The launch switch ────────────────────────────────────────────────
    // false: nsmakeupartistry.com serves the holding page in worker/holding.ts
    //        and nothing else. No markup, no images, no bundle.
    // true:  the real site.
    //
    // AT LAUNCH: set this to true and delete `run_worker_first` above, in one
    // commit, then push to main. Confirm with:
    //     curl -s https://nsmakeupartistry.com/api/health
    "LAUNCHED": false,

    // Read only by the holding page, which has no bundle to be inlined into.
    // The site itself uses VITE_WHATSAPP_NUMBER, a Build variable, and the two
    // are unrelated at runtime — this one can be deleted at launch with the
    // rest of the holding page.
    "WHATSAPP_NUMBER": "919380758632",

    // Where enquiries land. Already on the site as a mailto link, so listing
    // it here exposes nothing new.
    "ENQUIRY_TO": "contact@nsmakeupartistry.com",

    // Resend's shared sandbox sender, which delivers *only* to the address the
    // Resend account was registered with — any other recipient comes back 403.
    // Once send.nsmakeupartistry.com is verified at resend.com/domains, change
    // this to "Naga Sushmitha <enquiries@send.nsmakeupartistry.com>" and
    // ENQUIRY_TO can be any inbox.
    "ENQUIRY_FROM": "Naga Sushmitha <onboarding@resend.dev>"
  },

  // Lets /api/health report which deploy is answering, so "did my push go
  // live?" is a question with an answer rather than a guess about asset
  // hashes.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },

  // The handler reports refusals with console.error rather than throwing;
  // without this, those lines have nowhere to land.
  "observability": {
    "enabled": true
  },

  // On, and load-bearing. This Worker's two workers.dev addresses are the
  // preview mechanism:
  //
  //   nsmakeupartistry.morning-snowflake-3ec9.workers.dev    what main deploys
  //   <version>-nsmakeupartistry.morning-snowflake-3ec9...   one per version
  //
  // Both end in .workers.dev, which is what worker/index.ts keys the gate on:
  // the domain stays shut while either of these serves the full site. Turning
  // this off would take the preview URLs down with it.
  "workers_dev": true,

  // The custom domain, declared here rather than clicked into the dashboard,
  // so that deploying is what attaches it and the binding between Worker and
  // domain is reviewable in the same file as everything else.
  //
  // `custom_domain: true` is what makes Cloudflare create the DNS record and
  // issue the certificate; a plain route would expect the record to already
  // exist. Detaching a custom domain in the dashboard *deletes* that record —
  // the apex stops resolving entirely, which looks far more broken than a
  // holding page — so re-attaching is a deploy, not a dashboard visit.
  //
  // www is deliberately absent. Pointing it here too would serve the site on
  // two hostnames and hand Google a duplicate; it wants a Redirect Rule to the
  // apex instead. See README.
  "routes": [{ "pattern": "nsmakeupartistry.com", "custom_domain": true }]
}
